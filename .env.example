# CultureConnect environment variables
# Copy this file to `.env` for local dev, and set the same values in Netlify
# (Site settings → Environment variables) for production.
#
# These are read at BUILD time by Vite, so they must start with VITE_.

# --- Real Google Sign-In for admins ---------------------------------------
# Your Google OAuth 2.0 Client ID. When this is set, the admin "Sign in with
# Google" button uses genuine Google accounts. When it's empty, admin sign-in
# runs in a clearly-labelled demo mode (the invite flow still works the same).
#
# How to get one (about 5 minutes, free):
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create (or pick) a project.
#   3. Configure the OAuth consent screen (External is fine; add yourself as a
#      test user while it's unpublished).
#   4. Create Credentials → "OAuth client ID" → Application type: "Web application".
#   5. Under "Authorised JavaScript origins" add the sites you'll sign in from:
#         http://localhost:5173
#         https://YOUR-SITE.netlify.app   (and your custom domain if any)
#   6. Copy the Client ID (looks like 1234567890-abc123.apps.googleusercontent.com)
#      and paste it below.
VITE_GOOGLE_CLIENT_ID=

# --- Shared database (the real backend) -----------------------------------
# Connection string for the Postgres database that ALL admins and the public
# site read and write through. This is what makes an edit by one admin show up
# for every other admin and on the live storefront — instead of being trapped
# in one browser's localStorage.
#
# This is read at RUN time by the Netlify Functions in netlify/functions/, so
# it is a SERVER-SIDE secret and must NOT start with VITE_ (that would ship it
# to the browser). Never commit the real value.
#
# Easiest free option — Neon (managed serverless Postgres):
#   1. Create a free project at https://neon.tech
#   2. Copy the "Pooled connection" string (it looks like the line below).
#   3. Local dev:  put it in .env and run `netlify dev` (not `npm run dev`, so
#      the functions run too).
#   4. Production: set it in Netlify → Site settings → Environment variables.
# The database schema and demo seed data are created automatically on first use.
#
# Until DATABASE_URL is set, the app still runs in the old front-end-only demo
# mode (per-browser localStorage) so nothing breaks — it just isn't shared.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Invite link signing secret -------------------------------------------
# Used to sign admin invite links so they can't be tampered with. Set this to a
# long random string in production. (Prototype note: because this is a
# front-end-only app, the secret ships in the built JS — real tamper-proofing
# needs a backend. See src/lib/adminAuth.js.)
VITE_ADMIN_INVITE_SECRET=
